# Drizzle
DATABASE_URL=local.db

# AES-256-GCM key for src/lib/server/crypto/secrets.ts — 32 bytes of hex (64 chars).
# Only needed once code starts calling encryptSecret/decryptSecret. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=

# Google OAuth client (DESIGN.md §2.6). From the Google Cloud Console credentials page.
# For local dev, add http://localhost:5173/auth/google/callback as an authorized redirect
# URI on the same OAuth client alongside the Pi's Tailscale URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# The sync loop runs in dev too. Set HEARTH_SYNC_ENABLED=false to silence it, or shorten
# the interval to watch it work.
HEARTH_SYNC_INTERVAL_MINUTES=5
HEARTH_SYNC_ENABLED=true

# Music (docs/phase-7-music-plan.md). Point at a local folder of test playlists to try
# scripts/music:scan without the real NAS mount.
HEARTH_MUSIC_DIR=
# Where scan-music.mjs caches each track's extracted cover art. Defaults to the Pi's NAS
# cache path, which won't exist locally — set this to try music:scan against real files.
# HEARTH_MUSIC_COVERS_DIR=

# Photos (DESIGN.md §6). All four default to the Pi's NAS/SD-card paths, which won't
# exist locally — set these to try photos:resize against a local folder of test photos
# instead. HEARTH_PHOTOS_FALLBACK_DIR/_KEEP only matter once the fallback rotation itself
# is what you're testing.
# HEARTH_PHOTOS_DIR=
# HEARTH_PHOTOS_CACHE_DIR=
# HEARTH_GUEST_PHOTOS_DIR=
# HEARTH_PHOTOS_FALLBACK_DIR=
# HEARTH_PHOTOS_FALLBACK_KEEP=30

# Nightly backup (scripts/backup.mjs) / backup:verify. Defaults to the Pi's NAS path —
# set HEARTH_BACKUP_DIR to try either locally against a scratch directory.
# HEARTH_BACKUP_DIR=
# HEARTH_BACKUP_KEEP=14

# Only needed if you browse the dev server at http://localhost:5173 — "localhost" means
# "myself" to a real Chromecast device, so it can't fetch a track URL built from it. Set
# this to your machine's LAN IP or mDNS hostname (e.g. http://192.168.1.50:5173 or
# http://your-mac.local:5173) to actually test casting locally. Not needed on the real Pi
# deploy, where the request's own origin (http://hearth.local:8080) is already correct.
HEARTH_STREAM_BASE_URL=
