{
	"name": "hearth",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:apply": "node --env-file=.env scripts/migrate.mjs",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"seed:users": "node --env-file=.env scripts/seed-users.mjs",
		"photos:resize": "node --env-file=.env scripts/resize-photos.mjs",
		"music:scan": "node --env-file=.env scripts/scan-music.mjs",
		"anylist:connect": "node --env-file=.env scripts/connect-anylist.mjs",
		"anylist:smoke": "node --env-file=.env scripts/anylist-smoke.mjs",
		"backup:verify": "node --env-file=.env scripts/verify-backup.mjs",
		"todoist:connect": "node --env-file=.env scripts/connect-todoist.mjs",
		"todoist:smoke": "node --env-file=.env scripts/todoist-smoke.mjs",
		"cast:smoke": "node --env-file=.env scripts/cast-smoke.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"anylist": "^0.8.6",
		"better-sqlite3": "^13.0.2",
		"blurhash": "^2.0.5",
		"bonjour-service": "^1.4.4",
		"castv2-client": "^1.2.0",
		"drizzle-orm": "^0.45.2",
		"exifr": "^7.1.3",
		"hash-wasm": "^4.12.0",
		"music-metadata": "^11.15.0",
		"node-id3": "^0.2.9",
		"sharp": "^0.35.3",
		"suncalc": "^2.0.1"
	},
	"overrides": {
		"castv2": {
			"protobufjs": "^7.5.5"
		}
	}
}
