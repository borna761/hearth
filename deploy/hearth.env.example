# Copy to /etc/hearth/hearth.env with mode 0600, owned by hearth:hearth.
#   sudo install -d -m 0700 -o hearth -g hearth /etc/hearth
#   sudo install -m 0600 -o hearth -g hearth deploy/hearth.env.example /etc/hearth/hearth.env
#   sudo nano /etc/hearth/hearth.env

# The live database — DESIGN.md §3.5: stays on the SD card, never on the NAS.
DATABASE_URL=/var/lib/hearth/hearth.db

# 32 bytes of hex (64 characters) for AES-256-GCM, encrypting the connections.secrets
# column (src/lib/server/crypto/secrets.ts). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every stored OAuth/AnyList credential unrecoverable — back it up
# somewhere other than the Pi's SD card.
SECRETS_KEY=REPLACE_ME

# Tablet -> Pi is plain LAN HTTP (DESIGN.md §3.2); adapter-node listens on these directly.
HOST=0.0.0.0
PORT=8080
# Must exactly match the scheme+host+port used to reach this Pi (SvelteKit checks it
# against incoming request Origin headers, rejecting POSTs that don't match — grocery
# adds, PIN entry, etc.). hearth.local only resolves if this Pi's hostname is actually
# "hearth" (see the hostname note in deploy/README.md) — if it kept a different hostname,
# use that instead: <hostname>.local, <hostname>.lan, or a DHCP-reserved IP.
ORIGIN=http://hearth.local:8080

# Google OAuth client — DESIGN.md §2.6. Created in the Google Cloud Console; the consent
# screen must be "In production", or refresh tokens expire after seven days.
# GOOGLE_REDIRECT_URI must exactly match an authorized redirect URI on that OAuth client,
# and must be the HTTPS Tailscale address (§3.2) — Google rejects plain-HTTP redirects for
# anything but localhost, which is why Tailscale Serve exists in this design at all.
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=https://<this-pi>.<tailnet>.ts.net/auth/google/callback

# Calendar sync loop (DESIGN.md §3.1). Runs in-process, not as its own systemd unit —
# only the photo resize is split out (§6), because only it has a memory spike worth
# isolating. The nightly full re-sync at 02:00 is driven by this same loop, so the
# interval must stay well under a day.
HEARTH_SYNC_INTERVAL_MINUTES=5
# Set to false to stop the loop entirely (useful when debugging on the Pi).
HEARTH_SYNC_ENABLED=true

# Groceries (AnyList, docs/phase-5-plan.md §2.3). The account itself is connected through
# the Settings screen (email + password, admin-gated) or scripts/connect-anylist.mjs, not
# an env var — its credentials live encrypted in connections.secrets, under SECRETS_KEY
# above. This is only where the library persists its own login/session tokens between
# process restarts; the library's built-in default (~/.anylist_credentials) is wrong under
# systemd running as the hearth user, and fails at write time, after a successful login,
# which looks like an auth problem rather than a filesystem one. Optional — shown here at
# its actual default, so leaving it unset is fine.
# HEARTH_ANYLIST_CREDENTIALS_FILE=/var/lib/hearth/anylist-credentials

# Nightly backup job (scripts/backup.mjs), triggered by deploy/hearth-backup.timer.
HEARTH_BACKUP_DIR=/mnt/nas/hearth/backups
HEARTH_BACKUP_KEEP=14

# Nightly photo resize job (scripts/resize-photos.mjs), triggered by
# deploy/hearth-resize.timer — DESIGN.md §6. Pictures are read-only; cache/ holds the
# derivatives the screensaver actually serves, written nightly. HEARTH_PHOTOS_FALLBACK_DIR
# stays on the Pi's SD card (unlike the other two, which live on the NAS) — it exists
# specifically so the screensaver still has something to show if the NAS goes away.
HEARTH_PHOTOS_DIR=/mnt/nas/hearth/pictures
HEARTH_PHOTOS_CACHE_DIR=/mnt/nas/hearth/cache
HEARTH_PHOTOS_FALLBACK_DIR=/var/lib/hearth/fallback
HEARTH_PHOTOS_FALLBACK_KEEP=30

# Guest mode's own photo library (DESIGN.md §5/§6) — a sibling of HEARTH_PHOTOS_DIR,
# scanned into the same photos table by the same nightly job, tagged kind: 'guest' so
# guest mode never shows a family photo and vice versa. Optional: an empty or missing
# folder just means guest mode keeps falling back to Picsum, the same as before this
# existed — nothing breaks if you never create it.
HEARTH_GUEST_PHOTOS_DIR=/mnt/nas/hearth/guest-pictures

# Nightly music library scan (scripts/scan-music.mjs), triggered by
# deploy/hearth-music-scan.timer — docs/phase-7-music-plan.md. One folder directly under
# this directory is one playlist; the app streams straight from these NAS paths, no
# derivative files. Read-only from Hearth's perspective, same as photos.
HEARTH_MUSIC_DIR=/mnt/nas/hearth/music

# Where scan-music.mjs caches each track's embedded cover art (extracted from its ID3 tag,
# if it has one) — same derivative-file idea as HEARTH_PHOTOS_CACHE_DIR, just for artwork
# instead of resized photos.
HEARTH_MUSIC_COVERS_DIR=/mnt/nas/hearth/cache/music-covers

# Overrides the base URL Hearth hands a Cast speaker for each track it queues
# (src/lib/server/musicStreamUrl.ts). Without this, that URL is built from url.origin —
# and adapter-node's handler.js sets url.origin from the ORIGIN var above UNCONDITIONALLY
# whenever ORIGIN is set (`base: origin || get_origin(req.headers)`), regardless of which
# host/IP the browser actually used to reach the Pi. So the track URL a Cast speaker gets
# is always built from ORIGIN's hostname, never from whatever address happened to load the
# page — confirmed live: even browsing straight to the Pi's IP didn't help, because ORIGIN
# still won. docs/phase-7-music-plan.md §5 introduced this var for local dev (a Chromecast
# can't resolve "localhost" back to the machine serving it), but it's load-bearing in
# production too whenever ORIGIN is a hostname the Cast speaker itself can't resolve —
# this Pi's actual hostname is raspberrypi.lan (a router-DNS name, not a real mDNS .local
# one), and Google Cast devices don't reliably resolve it. Symptom without this set:
# queueLoad "succeeds" (that's just a control-channel command to the already
# mDNS-discovered speaker) but playerState sits in IDLE forever — the speaker accepted the
# command but never actually fetched the file. Point this at the Pi's LAN IP to sidestep
# hostname resolution entirely:
# HEARTH_STREAM_BASE_URL=http://192.168.1.50:8080
