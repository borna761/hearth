# Nightly at 03:20 — inside the tablet's 22:00-07:00 quiet hours (DESIGN.md §9.2), ten
# minutes after hearth-resize.timer and twenty after hearth-backup.timer, purely to spread
# out CPU/memory load rather than avoid any lock (see hearth-backup.service).
# Install: sudo cp deploy/hearth-music-scan.* /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now hearth-music-scan.timer
[Unit]
Description=Run the Hearth nightly music library scan at 03:20

[Timer]
OnCalendar=*-*-* 03:20:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
